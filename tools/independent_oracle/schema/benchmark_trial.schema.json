{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/000jitendra000/QCC_Quantum_Circuit_Compiler/tools/independent_oracle/schema/benchmark_trial.schema.json",
  "title": "QCC vs Qiskit Per-Trial Benchmark Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "case_id",
    "family",
    "target",
    "trial_index",
    "compiler",
    "compiler_version",
    "seed",
    "is_deterministic",
    "internal_sabre_trials",
    "compile_success",
    "compile_wall_time_ms",
    "physical_qubits",
    "single_qubit_gates",
    "multi_qubit_gates",
    "total_gates",
    "cx_count",
    "logical_swaps",
    "router_swaps_inserted",
    "final_emitted_swaps",
    "circuit_depth",
    "semantic_status",
    "max_amplitude_error",
    "ancilla_zero_ok",
    "compiler_options"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "qcc.benchmark_trial" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "case_id": { "type": "string" },
    "family": { "type": "string" },
    "target": { "type": "string" },
    "trial_index": { "type": "integer", "minimum": 0 },
    "compiler": { "type": "string", "enum": ["qcc", "qiskit"] },
    "compiler_version": { "type": "string" },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "is_deterministic": { "type": "boolean" },
    "internal_sabre_trials": { "type": ["integer", "null"], "minimum": 1 },
    "compile_success": { "type": "boolean" },
    "compile_wall_time_ms": { "type": "number", "minimum": 0 },
    "physical_qubits": { "type": ["integer", "null"], "minimum": 0 },
    "single_qubit_gates": { "type": ["integer", "null"], "minimum": 0 },
    "multi_qubit_gates": { "type": ["integer", "null"], "minimum": 0 },
    "total_gates": { "type": ["integer", "null"], "minimum": 0 },
    "cx_count": { "type": ["integer", "null"], "minimum": 0 },
    "logical_swaps": { "type": "integer", "minimum": 0 },
    "router_swaps_inserted": { "type": ["integer", "null"], "minimum": 0 },
    "final_emitted_swaps": { "type": ["integer", "null"], "minimum": 0 },
    "circuit_depth": { "type": ["integer", "null"], "minimum": 0 },
    "semantic_status": { "type": "string", "enum": ["PASS", "MISMATCH", "UNSUPPORTED", "INVALID_INPUT", "ERROR"] },
    "max_amplitude_error": { "type": ["number", "null"] },
    "ancilla_zero_ok": { "type": ["boolean", "null"] },
    "compiler_options": { "type": "object" }
  }
}
