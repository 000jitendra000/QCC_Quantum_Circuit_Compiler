{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/000jitendra000/QCC_Quantum_Circuit_Compiler/tools/independent_oracle/schema/optimizer_validation.schema.json",
  "title": "QCC Independent Optimizer Validation and Comparative Benchmark (Phase 81)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "timestamp_utc",
    "environment",
    "benchmark_config",
    "cases_evaluated",
    "case_results",
    "aggregate_summary",
    "oracle_verification_summary",
    "outcome_classification",
    "default_enablement_recommendation"
  ],
  "properties": {
    "schema_id": { "type": "string", "const": "qcc.optimizer_validation_benchmark" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "timestamp_utc": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["os", "architecture", "python_version", "qiskit_version", "qcc_version"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "python_version": { "type": "string" },
        "qiskit_version": { "type": "string" },
        "qcc_version": { "type": "string" }
      }
    },
    "benchmark_config": {
      "type": "object",
      "required": ["corpus_file", "optimization_level", "trials_per_case", "verified_with_oracle"],
      "properties": {
        "corpus_file": { "type": "string" },
        "optimization_level": { "type": "string" },
        "trials_per_case": { "type": "integer", "minimum": 1 },
        "verified_with_oracle": { "type": "boolean" }
      }
    },
    "cases_evaluated": { "type": "integer", "minimum": 1 },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "family",
          "target",
          "logical_qubits",
          "opportunity_type",
          "control",
          "treatment",
          "delta",
          "oracle_verification"
        ],
        "properties": {
          "case_id": { "type": "string" },
          "family": { "type": "string" },
          "target": { "type": "string" },
          "logical_qubits": { "type": "integer", "minimum": 1 },
          "opportunity_type": { "type": "string", "enum": ["positive", "control"] },
          "control": {
            "type": "object",
            "required": ["total_gates", "two_qubit_gates", "router_swaps", "circuit_depth", "compile_time_ms_median"],
            "properties": {
              "total_gates": { "type": "integer", "minimum": 0 },
              "two_qubit_gates": { "type": "integer", "minimum": 0 },
              "router_swaps": { "type": "integer", "minimum": 0 },
              "final_emitted_swaps": { "type": "integer", "minimum": 0 },
              "circuit_depth": { "type": "integer", "minimum": 0 },
              "compile_time_ms_median": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_min": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_max": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_spread": { "type": "number", "minimum": 0.0 }
            }
          },
          "treatment": {
            "type": "object",
            "required": ["total_gates", "two_qubit_gates", "router_swaps", "circuit_depth", "compile_time_ms_median"],
            "properties": {
              "total_gates": { "type": "integer", "minimum": 0 },
              "two_qubit_gates": { "type": "integer", "minimum": 0 },
              "router_swaps": { "type": "integer", "minimum": 0 },
              "final_emitted_swaps": { "type": "integer", "minimum": 0 },
              "circuit_depth": { "type": "integer", "minimum": 0 },
              "compile_time_ms_median": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_min": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_max": { "type": "number", "minimum": 0.0 },
              "compile_time_ms_spread": { "type": "number", "minimum": 0.0 }
            }
          },
          "delta": {
            "type": "object",
            "required": ["gates_delta", "two_qubit_delta", "swaps_delta", "depth_delta", "compile_time_delta_ms", "compile_time_overhead_ratio"],
            "properties": {
              "gates_delta": { "type": "integer" },
              "two_qubit_delta": { "type": "integer" },
              "swaps_delta": { "type": "integer" },
              "depth_delta": { "type": "integer" },
              "compile_time_delta_ms": { "type": "number" },
              "compile_time_overhead_ratio": { "type": "number" }
            }
          },
          "pass_diagnostics": {
            "type": "object",
            "required": ["status", "operations_removed", "duration_ms"],
            "properties": {
              "status": { "type": "string" },
              "operations_removed": { "type": "integer", "minimum": 0 },
              "duration_ms": { "type": "number", "minimum": 0.0 }
            }
          },
          "oracle_verification": {
            "type": "object",
            "required": ["status", "ancilla_zero_ok", "max_amplitude_error", "strict_phase_accounting"],
            "properties": {
              "status": { "type": "string", "enum": ["PASS", "MISMATCH", "UNSUPPORTED", "NOT_RUN"] },
              "ancilla_zero_ok": { "type": "boolean" },
              "max_amplitude_error": { "type": "number", "minimum": 0.0 },
              "strict_phase_accounting": { "type": "string" }
            }
          }
        }
      }
    },
    "aggregate_summary": {
      "type": "object",
      "required": [
        "total_cases",
        "positive_opportunity_cases",
        "control_cases",
        "logical_level",
        "physical_level",
        "compilation_overhead"
      ],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 1 },
        "positive_opportunity_cases": { "type": "integer", "minimum": 0 },
        "control_cases": { "type": "integer", "minimum": 0 },
        "logical_level": {
          "type": "object",
          "required": [
            "total_logical_pairs_removed",
            "total_logical_operations_removed",
            "cases_with_logical_reductions"
          ],
          "properties": {
            "total_logical_pairs_removed": { "type": "integer", "minimum": 0 },
            "total_logical_operations_removed": { "type": "integer", "minimum": 0 },
            "cases_with_logical_reductions": { "type": "integer", "minimum": 0 }
          }
        },
        "physical_level": {
          "type": "object",
          "required": [
            "total_physical_gates_saved",
            "total_physical_two_qubit_saved",
            "swaps_improved",
            "swaps_unchanged",
            "swaps_worsened",
            "depth_improved",
            "depth_unchanged",
            "depth_worsened",
            "total_gates_improved",
            "total_gates_unchanged",
            "total_gates_worsened",
            "two_qubit_improved",
            "two_qubit_unchanged",
            "two_qubit_worsened"
          ],
          "properties": {
            "total_physical_gates_saved": { "type": "integer" },
            "total_physical_two_qubit_saved": { "type": "integer" },
            "swaps_improved": { "type": "integer", "minimum": 0 },
            "swaps_unchanged": { "type": "integer", "minimum": 0 },
            "swaps_worsened": { "type": "integer", "minimum": 0 },
            "depth_improved": { "type": "integer", "minimum": 0 },
            "depth_unchanged": { "type": "integer", "minimum": 0 },
            "depth_worsened": { "type": "integer", "minimum": 0 },
            "total_gates_improved": { "type": "integer", "minimum": 0 },
            "total_gates_unchanged": { "type": "integer", "minimum": 0 },
            "total_gates_worsened": { "type": "integer", "minimum": 0 },
            "two_qubit_improved": { "type": "integer", "minimum": 0 },
            "two_qubit_unchanged": { "type": "integer", "minimum": 0 },
            "two_qubit_worsened": { "type": "integer", "minimum": 0 }
          }
        },
        "compilation_overhead": {
          "type": "object",
          "required": [
            "mean_compile_time_control_ms",
            "mean_compile_time_treatment_ms",
            "overall_overhead_factor",
            "mean_pass_duration_ms"
          ],
          "properties": {
            "mean_compile_time_control_ms": { "type": "number", "minimum": 0.0 },
            "mean_compile_time_treatment_ms": { "type": "number", "minimum": 0.0 },
            "overall_overhead_factor": { "type": "number", "minimum": 0.0 },
            "mean_pass_duration_ms": { "type": "number", "minimum": 0.0 }
          }
        }
      }
    },
    "oracle_verification_summary": {
      "type": "object",
      "required": [
        "total_verified",
        "pass_count",
        "fail_count",
        "clean_ancilla_pass_rate",
        "strict_phase_accounting_summary"
      ],
      "properties": {
        "total_verified": { "type": "integer", "minimum": 0 },
        "pass_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "clean_ancilla_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "strict_phase_accounting_summary": {
          "type": "object",
          "required": ["pass", "mismatch", "unverified"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "mismatch": { "type": "integer", "minimum": 0 },
            "unverified": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "outcome_classification": {
      "type": "string",
      "enum": [
        "A_CLEAR_BENEFIT",
        "B_LOGICAL_BENEFIT_ONLY",
        "C_MIXED_RESULT",
        "D_NO_MEASURABLE_BENEFIT",
        "E_NEGATIVE_RESULT",
        "F_INSUFFICIENT_EVIDENCE"
      ]
    },
    "default_enablement_recommendation": {
      "type": "object",
      "required": ["enable_by_default", "rationale", "prerequisites_or_conditions"],
      "properties": {
        "enable_by_default": { "type": "boolean" },
        "rationale": { "type": "string" },
        "prerequisites_or_conditions": { "type": "string" }
      }
    }
  }
}

